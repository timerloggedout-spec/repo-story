# Repo-Story shipped defaults (SPEC section 3). Per-repo overrides edit
# values here; the engine reads only this file.
blast_tau = 0.5
cluster_window_hours = 24
history_window_commits = 200
narrate_budget_seconds = 120
llm_provider = none
llm_env_key = REPO_STORY_LLM_API_KEY
noise_patterns = lock,.lock,.min.js,.map,__snapshots__,.snap
audit_sample_size = 5
audit_seed = 42
